      "name": "EDTA 全血",
      "timing": "發燒時，未服抗瘧藥前",
      "container": "EDTA 紫頭管",
      "volume": "3 mL",
      "storage": "室溫（24 小時內）或 2–8°C",
      "transport": "室溫或冷藏運送",
      "tests": [
        "顯微鏡鏡檢",
