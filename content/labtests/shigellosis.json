  "summary": "桿菌性痢疾：糞便或肛門拭子置 Cary-Blair 運送培養基，冷藏 24 小時內送驗，做細菌培養、血清分型與抗藥性監測。",
  "keywords": [
    "桿菌性痢疾",
    "檢體",
    "送驗",
    "採檢",
    "細菌培養",
    "血清分型"
  ],
  "note": "檢體量、保存與時效為原型示意，以檢驗及疫苗研製中心「傳染病檢體採檢手冊」現行版為準",
  "disease": "disease.shigellosis",
  "specimens": [
    {
      "name": "糞便",
      "timing": "腹瀉期間、使用抗生素前",
      "container": "Cary-Blair 運送培養基",
      "volume": "糞便 2–5 g（水樣便 5 mL）",
      "storage": "2–8°C 冷藏",
      "transport": "2–8°C 冷藏運送（UN3373 三層包裝）",
      "tests": [
        "細菌培養",
        "血清分型",
        "抗生素感受性"
      ],
      "turnaroundDays": 3
    },
    {
      "name": "肛門拭子",
      "timing": "無法取得糞便時",
      "container": "Cary-Blair 運送培養基",
      "volume": "拭子 1 支（可見糞便沾染）",
      "storage": "2–8°C 冷藏",
      "transport": "2–8°C 冷藏運送（UN3373 三層包裝）",
      "tests": [
        "細菌培養"
      ],
      "turnaroundDays": 3
    }
  ],
