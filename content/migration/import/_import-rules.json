    {
      "match": "結核病／疾病介紹",
      "owner": "unit.chronic-infectious"
    },
    {
      "match": "結核病／預防接種",
      "owner": "unit.chronic-infectious"
    },
    {
      "match": "結核病／Q&A",
      "owner": "unit.chronic-infectious"
    },
    {
      "match": "結核病／宣導素材",
      "owner": "unit.chronic-infectious"
    },
    {
      "match": "結核病／指引及手冊",
      "owner": "unit.chronic-infectious"
    },
    {
      "match": "結核病／通報定義",
      "owner": "unit.chronic-infectious"
    },
    {
      "match": "結核病／防治政策",
      "owner": "unit.chronic-infectious"
    },
    {
      "match": "結核病／外籍人士健檢",
      "owner": "unit.chronic-infectious"
    },
    {
      "match": "結核病／研究成果",
      "owner": "unit.chronic-infectious"
    },
    {
      "match": "結核病／最新消息",
      "owner": "unit.chronic-infectious"
    },
    {
      "_comment": "以下不綁疾病：任何欄目樹的檢驗／統計／通報子類別都歸同一單位；其他子類別由 ownerFallbackToDisease 依疾病主檔的 owner 決定",
      "match": "／檢驗",
      "owner": "unit.lab"
    },
    {
      "match": "／統計資料",
      "owner": "unit.epidemic-intelligence"
    },
    {
      "match": "／統計",
      "owner": "unit.epidemic-intelligence"
    },
    {
      "match": "／通報",
      "owner": "unit.epidemic-intelligence"
    },
    {
      "match": "感染管制",
      "owner": "unit.infection-control"
    },
    {
      "match": "首頁／指引及手冊",
      "owner": "unit.oasis",
      "_comment": "第七批：指引及手冊欄目的總覽列表頁歸 OASIS（文件庫）；各文件頁的麵包屑是「傳染病介紹／某疾病／指引及手冊」，對不到這條，權責依疾病主檔（ownerFallbackToDisease）"
    },
    {
      "match": "新聞與公告",
      "owner": "unit.pr",
      "preferDiseaseFor": [
        "letter"
      ]
    },
    {
      "match": "News",
      "owner": "unit.pr"
    },
    {
      "match": "預防接種／常見問答",
      "owner": "unit.acute-infectious",
      "_comment": "第八批：不綁疾病的預防接種問答歸急性組（預防接種業務）"
    },
    {
      "match": "國際旅遊與健康",
      "owner": "unit.quarantine"
    },
    {
      "match": "首頁／常見問答",
      "owner": "unit.oasis",
      "_comment": "第八批：常見問答欄目的總覽列表頁歸 OASIS；各主題頁由更長的規則或疾病主檔決定"
    }
  ],
  "defaultOwner": "unit.oasis",
  "ownerFallbackToDisease": true,
  "diseases": [
    {
      "_comment": "疾病候選以 content/master/diseases.json 全部疾病為底；這裡只補主檔沒有的舊站寫法與草稿 id 用的短碼（沒寫 short 就用主檔 id 去掉 disease.）",
      "id": "disease.tuberculosis",
      "short": "tb",
      "aliases": [
        "結核病",
        "結核",
        "肺結核",
        "潛伏結核感染",
