  "summary": "醫院申請成為傳染病防治醫療網應變醫院或設置負壓隔離病床，須符合設施、人員與感染管制基準，經區管中心實地審查與指定，處理期間約 60 日。",
  "keywords": [
    "傳染病防治醫療網",
    "應變醫院",
    "隔離病床",
    "負壓病房",
    "指定"
  ],
  "slug": "response-hospital-designation",
  "serviceType": "license",
  "whoCanApply": [
    "醫院",
    "地方衛生局"
  ],
  "introMarkdown": "依《傳染病防治法》第 14 條，中央主管機關得指定**傳染病防治醫療網**之應變醫院、隔離醫院與隔離病床，平時維持量能、疫情時收治傳染病病人。\n\n申請醫院須符合負壓隔離病房設施、感染管制人力、教育訓練與演習等基準，並接受定期查核與經費補助。",
  "requiredDocuments": [
    "申請書",
    "負壓隔離病房設施規格與檢測報告",
    "感染管制人力配置",
    "年度教育訓練與演習計畫",
    "地方衛生局推薦函"
  ],
  "steps": [
    {
      "title": "向衛生局提出申請",
      "text": "檢附應備文件。",
      "who": "醫院",
      "days": 1
    },
    {
      "title": "衛生局初審推薦",
      "text": "確認區域需求與文件。",
      "who": "地方衛生局",
      "days": 14
    },
    {
      "title": "區管中心實地審查",
      "text": "查核設施、動線與人員訓練。",
      "who": "區管制中心",
      "days": 30
    },
    {
      "title": "指定與公告",
      "text": "核定後發函指定並納入醫療網名冊。",
      "who": "整備應變組",
      "days": 15
    }
  ],
  "slaDays": 60,
  "fee": "免費",
  "legalBasis": [
    "傳染病防治法第 14 條",
    "傳染病防治醫療網作業辦法"
  ],
