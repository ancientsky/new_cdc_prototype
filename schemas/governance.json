{
  "$id": "https://cdc-prototype/schemas/governance.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "治理設定檔",
  "$defs": {
    "aiStatus": {
      "type": "object",
      "required": [
        "paused",
        "updatedAt",
        "updatedBy"
      ],
      "properties": {
        "paused": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "updatedBy": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "extractive",
            "llm"
          ]
        },
        "beta": {
          "type": "boolean"
        },
        "fallback": {
          "type": "string"
        }
      }
    },
    "whitelistPolicy": {
      "type": "object",
      "required": [
        "version",
        "allowedTypes",
        "approvedBy",
        "approvedAt"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "allowedTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedTypesPro": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approvedBy": {
          "type": "string"
        },
        "approvedAt": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "evalSet": {
      "type": "object",
      "required": [
        "version",
        "questions"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "q",
              "category",
              "expect"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "q": {
                "type": "string"
              },
              "lang": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "fact",
                  "refusal",
                  "version",
                  "situation",
                  "travel",
                  "vaccine",
                  "stats",
                  "rumor",
                  "professional",
                  "multilingual",
                  "adversarial",
                  "peak",
                  "apply",
                  "lab",
                  "notify",
                  "notice",
                  "media",
                  "nomatch",
                  "boundary",
                  "conflict"
                ]
              },
              "expect": {
                "type": "object",
                "properties": {
                  "intent": {
                    "type": "string"
                  },
                  "refuse": {
                    "type": "boolean"
                  },
                  "mustCite": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "答案必須引用的 contentId（前綴比對）"
                  },
                  "mustNotCite": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "mustInclude": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "mustNotInclude": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "verdict": {
                    "type": "string"
                  },
                  "disease": {
                    "type": "string"
                  },
                  "intentAny": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "mustCiteType": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "mustIncludeAny": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "mustCiteAny": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "conflict": {
                    "type": "boolean",
                    "description": "第三十三輪：true＝答案須帶「站內兩處說法不同」加註；false＝不得帶"
                  },
                  "noHistoricalFirst": {
                    "type": "boolean",
                    "description": "第三十三輪：第一個來源不得是歷史新聞稿"
                  }
                }
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "consistency": {
      "type": "object",
      "required": [
        "version",
        "decisions"
      ],
      "description": "第三十三輪：跨內容說法不一致的判定（content/governance/consistency.json，guide-staff §37）",
      "properties": {
        "version": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "a",
              "b",
              "decision",
              "decidedBy",
              "decidedAt"
            ],
            "additionalProperties": false,
            "properties": {
              "a": {
                "type": "string"
              },
              "b": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "decision": {
                "enum": [
                  "not-conflict",
                  "confirmed"
                ]
              },
              "prefer": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "decidedBy": {
                "type": "string"
              },
              "decidedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        }
      }
    }
  }
}
