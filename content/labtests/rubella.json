  "note": "檢體量、保存與時效為原型示意，以檢驗及疫苗研製中心「傳染病檢體採檢手冊」現行版為準",
  "disease": "disease.rubella",
  "specimens": [
    {
      "name": "咽喉拭子",
      "timing": "出疹日起 7 日內",
      "container": "病毒運送培養基（VTM）拭子管",
      "volume": "拭子 1 支",
      "storage": "2–8°C 冷藏",
      "transport": "2–8°C 冷藏運送（UN3373 三層包裝）",
      "tests": [
        "RT-PCR",
        "基因定型"
      ],
      "turnaroundDays": 2
    },
    {
      "name": "血清",
      "timing": "出疹後 5 日以上 IgM 較敏感",
      "container": "無菌血清分離管（紅頭或黃頭，無抗凝劑）",
      "volume": "血清 2–5 mL",
      "storage": "2–8°C 冷藏",
      "transport": "2–8°C 冷藏運送（UN3373 三層包裝）",
      "tests": [
        "IgM／IgG 抗體"
      ],
      "turnaroundDays": 2
    }
