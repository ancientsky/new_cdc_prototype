  "thresholds": {
    "minBodyChars": 40,
    "reviewConfidence": 0.6,
    "autoConfidence": 0.8,
    "archiveAfterYears": 3,
    "summaryChars": 120,
    "sampleRate": 0.1
  },
  "confidence": {
    "_comment": "ARCHITECTURE 17.3：型別對應明確 +0.4、owner 對應 +0.2、Markdown 無轉換警告 +0.2、附件全部找到 +0.1、無重複 +0.1；< reviewConfidence ⇒ 建議人工檢視",
    "type": 0.4,
    "owner": 0.2,
    "markdown": 0.2,
    "attachments": 0.1,
    "unique": 0.1
  },
