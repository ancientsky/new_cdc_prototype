      "id": "clar.2025-07-dengue-spraying-poison",
      "type": "clarification",
      "title": "網傳「登革熱噴藥會毒死人、可以拒絕開門」為錯誤訊息",
      "owner": "unit.pr",
      "publishedAt": "2025-07-15",
      "reviewedAt": "2026-07-10",
      "reviewPeriodMonths": 6,
      "status": "published",
      "audience": [
