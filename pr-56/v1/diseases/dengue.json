    "i18n": {
      "en": {
        "title": "Dengue fever",
        "summary": "Dengue is caused by dengue viruses transmitted by Aedes aegypti and Aedes albopictus mosquitoes. It does not spread directly from person to person. Taiwan is a high-risk area, with peaks in summer and autumn.",
        "keyFacts": {
          "incubation": "3–14 days (usually 4–7)",
          "symptoms": "Sudden high fever, headache, retro-orbital pain, muscle and joint pain, rash",
          "transmission": "Bite of infected Aedes mosquitoes",
          "prevention": "Remove standing water; avoid mosquito bites",
          "notify": "Within 24 hours"
        },
        "blocks": [
          {
            "key": "what-to-do",
            "heading": "What to do",
            "cards": [
              {
                "if": "have a fever and travelled to an affected area in the last two weeks",
                "title": "See a doctor within 24 hours",
                "text": "See a doctor within 24 hours and mention your travel history; an NS1 rapid test may be done."
              },
              {
                "if": "are confirmed and resting at home",
                "title": "The 1–2 days after the fever breaks are the most dangerous",
                "text": "Return immediately if any warning sign appears."
              },
              {
                "if": "live in an affected area",
                "title": "Check and empty standing water weekly",
                "text": "Wear light-coloured long sleeves and use repellent."
              }
            ]
          },
          {
            "key": "symptoms",
            "heading": "Symptoms and warning signs",
            "markdown": "Typical symptoms are sudden high fever (≥ 38°C), headache, pain behind the eyes, muscle and joint pain and rash. Most people recover on their own.\n\nA small number develop severe dengue, usually **around the time the fever subsides**. People infected a second time with a different serotype are at higher risk.",
            "warning": "Persistent vomiting, abdominal pain, mucosal bleeding, lethargy or restlessness, liver enlargement, rising haematocrit with falling platelets."
          },
          {
            "key": "transmission",
            "heading": "How it spreads",
            "markdown": "Dengue spreads through the bite of Aedes aegypti or Aedes albopictus mosquitoes carrying the virus. It is not transmitted directly between people. Patients are viraemic from one day before to five days after onset; a mosquito that bites them during this period can transmit the virus 8–12 days later."
          },
          {
            "key": "prevention",
            "heading": "Prevention",
            "markdown": "There is no routine vaccine in Taiwan. Prevention focuses on avoiding bites and removing breeding sites:\n\n- Check containers inside and outside your home every week: inspect, empty, clean and scrub.\n- Wear light-coloured long sleeves and trousers and use DEET, Picaridin or IR3535 repellent.\n- Install window and door screens; use bed nets if needed.\n- For two weeks after returning from an affected area, keep avoiding bites so you do not become a source of infection."
          },
          {
            "key": "treatment",
            "heading": "Diagnosis and treatment",
            "markdown": "There is no specific antiviral. Treatment is supportive: fluids and paracetamol for fever. Avoid aspirin and NSAIDs because of bleeding risk. During the febrile phase a doctor may order an NS1 antigen rapid test."
          },
          {
            "key": "vaccine",
            "heading": "Vaccine",
            "markdown": "Dengue vaccine is not part of Taiwan's routine schedule. Any change will be announced officially by Taiwan CDC."
          },
          {
            "key": "situation",
            "heading": "Current situation and statistics",
            "markdown": "Local case counts and vector density are updated daily on the situation layer and NIDSS."
          },
          {
            "key": "faq",
            "heading": "FAQ"
          }
        ]
      },
      "vi": {
        "title": "Sốt xuất huyết Dengue",
        "summary": "Sốt xuất huyết do vi-rút Dengue gây ra, lây qua vết đốt của muỗi Aedes aegypti và Aedes albopictus, không lây trực tiếp từ người sang người. Đài Loan là vùng nguy cơ cao, đỉnh dịch vào mùa hè và mùa thu.",
        "keyFacts": {
          "incubation": "3–14 ngày (thường 4–7 ngày)",
          "symptoms": "Sốt cao đột ngột, đau đầu, đau sau hốc mắt, đau cơ khớp, phát ban",
          "transmission": "Muỗi Aedes đốt",
          "prevention": "Dọn sạch nước đọng, tránh muỗi đốt",
          "notify": "Trong vòng 24 giờ"
        },
        "blocks": [
          {
            "key": "what-to-do",
            "heading": "Tôi nên làm gì",
            "cards": [
              {
                "if": "bị sốt và đã đến vùng dịch trong 2 tuần qua",
                "title": "Đi khám trong 24 giờ",
                "text": "Đi khám trong vòng 24 giờ, chủ động khai báo lịch sử đi lại; bác sĩ có thể làm xét nghiệm nhanh NS1."
              },
              {
                "if": "đã được chẩn đoán và đang nghỉ tại nhà",
                "title": "1–2 ngày sau khi hết sốt là nguy hiểm nhất",
                "text": "Xuất hiện dấu hiệu cảnh báo phải tái khám ngay."
              },
              {
                "if": "sống trong vùng dịch",
                "title": "Kiểm tra và đổ nước đọng hằng tuần",
                "text": "Mặc áo dài tay màu sáng, dùng thuốc chống muỗi."
              }
            ]
          },
          {
            "key": "symptoms",
            "heading": "Triệu chứng và dấu hiệu cảnh báo",
            "markdown": "Triệu chứng điển hình: sốt cao đột ngột (≥ 38°C), đau đầu, đau sau hốc mắt, đau cơ khớp, phát ban. Đa số tự khỏi.\n\nMột số ít chuyển nặng, thường vào **khoảng thời gian hết sốt**.",
            "warning": "Nôn liên tục, đau bụng, chảy máu niêm mạc, lừ đừ hoặc kích động, gan to, hematocrit tăng kèm tiểu cầu giảm."
          },
          {
            "key": "transmission",
            "heading": "Lây truyền",
            "markdown": "Lây qua muỗi Aedes mang vi-rút đốt; không lây trực tiếp giữa người với người."
          },
          {
            "key": "prevention",
            "heading": "Phòng ngừa",
            "markdown": "Chưa có vắc-xin thường quy tại Đài Loan. Phòng ngừa: dọn nước đọng hằng tuần, mặc áo dài tay, dùng thuốc chống muỗi chứa DEET, Picaridin hoặc IR3535, lắp lưới chống muỗi. Sau khi về từ vùng dịch, tiếp tục tránh muỗi đốt trong 2 tuần."
          },
          {
            "key": "treatment",
            "heading": "Chẩn đoán và điều trị",
            "markdown": "Không có thuốc kháng vi-rút đặc hiệu; điều trị hỗ trợ, hạ sốt bằng paracetamol; tránh aspirin và NSAID."
          },
          {
            "key": "vaccine",
            "heading": "Vắc-xin",
            "markdown": "Vắc-xin sốt xuất huyết chưa nằm trong lịch tiêm chủng thường quy của Đài Loan."
          },
          {
            "key": "situation",
            "heading": "Tình hình hiện nay và thống kê",
            "markdown": "Số ca nội địa và mật độ muỗi cập nhật hằng ngày."
          },
          {
            "key": "faq",
            "heading": "Câu hỏi thường gặp"
          }
        ]
      }
