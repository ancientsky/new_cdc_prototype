  "summary": "麻疹：咽喉拭子與尿液（出疹 5 日內）做 RT-PCR，血清做 IgM／IgG，冷藏 24 小時內送疾管署；三種檢體應同時採集。",
  "keywords": [
    "麻疹",
    "檢體",
    "送驗",
    "採檢",
    "RT-PCR",
    "基因定型"
  ],
  "note": "檢體量、保存與時效為原型示意，以檢驗及疫苗研製中心「傳染病檢體採檢手冊」現行版為準",
  "disease": "disease.measles",
  "specimens": [
    {
      "name": "咽喉拭子",
      "timing": "出疹日起 5 日內",
      "container": "病毒運送培養基（VTM）拭子管",
      "volume": "拭子 1 支",
      "storage": "2–8°C 冷藏",
      "transport": "2–8°C 冷藏運送（UN3373 三層包裝）",
      "tests": [
        "RT-PCR",
        "基因定型"
      ],
      "turnaroundDays": 1
    },
    {
      "name": "尿液",
      "timing": "出疹日起 5 日內",
      "container": "無菌尿液收集瓶",
      "volume": "10–50 mL",
      "storage": "2–8°C 冷藏",
      "transport": "2–8°C 冷藏運送（UN3373 三層包裝）",
      "tests": [
        "RT-PCR"
      ],
      "turnaroundDays": 1
    },
    {
      "name": "血清",
      "timing": "出疹後 3 日以上 IgM 較敏感",
      "container": "無菌血清分離管（紅頭或黃頭，無抗凝劑）",
      "volume": "血清 2–5 mL",
      "storage": "2–8°C 冷藏",
      "transport": "2–8°C 冷藏運送（UN3373 三層包裝）",
      "tests": [
        "IgM／IgG 抗體"
      ],
      "turnaroundDays": 2
    }
  ],
  "labs": [
    "cdc-lab"
  ],
  "sendWithinHours": 24,
  "formDoc": "https://www.cdc.gov.tw/File/Get/placeholder-form-lab-specimen-form",
  "caseDefinitionDoc": "doc.case-definition-measles",
  "biosafetyLevel": "BSL-2",
  "notesMarkdown": "- 疑似病例請同時採集咽喉拭子、尿液與血清三種檢體。\n- 採檢人員應具麻疹免疫力並配戴 N95 口罩。\n- 送驗單註明接種史與旅遊史；近期接種 MMR 者需基因定型區分疫苗株。",
  "i18n": {
    "en": {
      "title": "Measles: laboratory tests and specimen requirements",
      "summary": "Throat swab and urine within 5 days of rash for RT-PCR plus serum for IgM/IgG, refrigerated and sent to Taiwan CDC within 24 hours."
    }
  }
