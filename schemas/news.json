{
  "$id": "https://cdc-prototype/schemas/news.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "新聞稿／致醫界通函／澄清稿／其他訊息",
  "allOf": [{ "$ref": "_common.json" }],
  "type": "object",
  "required": ["newsType", "bodyMarkdown"],
  "properties": {
    "type": { "enum": ["news", "letter"] },
    "newsType": { "enum": ["press", "letter", "clarification", "other"], "description": "第七輪（ARCHITECTURE 15.1）起人才招募改用 job 型別（content/jobs/）、採購公告改用 tender 型別（content/tenders/），不再以新聞型別發布" },
    "bodyMarkdown": { "type": "string" },
    "letterNo": { "type": ["integer", "string"] },
    "deadlineAt": { "type": "string", "format": "date", "description": "其他訊息（newsType other）的截止日；過期自動標「已截止」並退出首頁列表" },
    "refNo": { "type": "string", "description": "公告字號" },
    "applyUrl": { "type": "string", "description": "報名／申請網址（外部）" },
    "positions": { "type": "integer" },
    "budgetNtd": { "type": "integer" },
    "region": { "type": "string" },
    "effectiveAt": { "type": "string", "format": "date", "description": "通函生效日" },
    "attachments": { "type": "array", "items": { "type": "object", "properties": { "label": { "type": "string" }, "url": { "type": "string" }, "machineReadable": { "type": "boolean" } } } },
    "situationDeclaration": {
      "type": "object",
      "description": "新聞稿中的疫情宣告（供態勢層與答案頁引用）",
      "properties": { "disease": { "type": "string" }, "text": { "type": "string" } }
    }
  }
}
