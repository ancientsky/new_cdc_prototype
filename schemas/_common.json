{
  "$id": "https://cdc-prototype/schemas/_common.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "所有內容共同欄位（治理欄位）",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "owner",
    "publishedAt",
    "reviewedAt",
    "reviewPeriodMonths",
    "status",
    "audience",
    "sensitivity",
    "license",
    "languages",
    "summary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9.-]*$",
      "description": "穩定可讀 ID，如 disease.dengue、news.2026-09-22-enterovirus"
    },
    "type": {
      "enum": [
        "disease",
        "faq",
        "news",
        "letter",
        "clarification",
        "document",
        "vaccine",
        "dataset",
        "banner",
        "page",
        "media",
        "topic",
        "service",
        "publication",
        "labtest",
        "research",
        "migration",
        "job",
        "tender"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "pattern": "^unit\\."
    },
    "steward": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "publishedAt": {
      "type": "string",
      "format": "date"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date"
    },
    "reviewPeriodMonths": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60
    },
    "nextReviewAt": {
      "type": "string",
      "format": "date",
      "description": "由治理引擎計算，不手填"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "published",
        "archived"
      ]
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "public",
          "professional"
        ]
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "enum": [
          "symptoms",
          "vaccines",
          "travel",
          "situation",
          "rumor",
          "data"
        ]
      }
    },
    "sensitivity": {
      "enum": [
        "public",
        "professional",
        "internal"
      ]
    },
    "license": {
      "type": "string"
    },
    "licenseNote": {
      "type": "string"
    },
    "basedOn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diseases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^disease\\."
      }
    },
    "vaccines": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^vaccine\\."
      }
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "aiWhitelist": {
      "type": "object",
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "approvedBy": {
          "type": "string"
        },
        "approvedAt": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "languages": {
      "type": "object",
      "required": [
        "zh-TW"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "source",
              "reviewed",
              "machine",
              "pending",
              "none"
            ]
          },
          "reviewedAt": {
            "type": "string",
            "format": "date"
          },
          "reviewer": {
            "type": "string"
          },
          "sourceHash": {
            "type": "string"
          }
        }
      },
      "description": "每語言一筆翻譯狀態；來源語言（sourceLang，預設 zh-TW）為 source。zh-TW 一律必填。"
    },
    "sourceLang": {
      "enum": [
        "zh-TW",
        "en",
        "ja",
        "tl",
        "vi",
        "id",
        "th"
      ],
      "default": "zh-TW",
      "description": "內容來源語言（ARCHITECTURE 14.2）：頂層欄位＝此語言文字；languages[sourceLang].status 必須為 source；其他語言（含 sourceLang≠zh-TW 時的 zh-TW）放 i18n.{lang}。sourceLang≠zh-TW 時 i18n[\"zh-TW\"] 必填且 languages[\"zh-TW\"].status 為 reviewed 或 machine（中文官網不能沒有中文）。sourceHash 以來源語言頂層欄位計算。"
    },
    "i18n": {
      "type": "object"
    },
    "sourceHash": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "maxLength": 400
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "legacyUrls": {
      "type": "array",
      "description": "現行官網對應網址（301 對照與來源連結）。舊網址 ID 不確定者以 URI Template 佔位（例：https://www.cdc.gov.tw/Disease/SubIndex/{id}），轉址時標 pattern、不進伺服器對照檔（ARCHITECTURE 13.1）",
      "items": {
        "type": "string",
        "format": "uri-template",
        "pattern": "^https?://"
      }
    },
    "auditRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pattern",
          "message"
        ],
        "properties": {
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pattern": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "linkChecks": {
      "type": "object",
      "description": "連結檢查結果（scripts/fetch-data.mjs --check-links 寫回）：{ applyUrl|videoUrl|pdfUrl: { lastCheckedAt, status } }",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "lastCheckedAt": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "ok",
              "broken",
              "unchecked"
            ]
          }
        }
      }
    }
  }
}
