{
  "id": "import-rules.legacy",
  "type": "import-rules",
  "version": 8,
  "title": "舊站匯出批次轉換規則（scripts/import-legacy.mjs 讀取）",
  "summary": "把舊站 CMS 匯出（每頁 .html＋.json 側檔）對應成新站內容草稿的規則：URL 模式→型別與目錄、類別→權責單位、疾病別名→疾病 id、標題關鍵字→疾病頁區塊、Bulletin typeid→newsType、信心計算權重與人工檢視門檻。規則是資料不是程式；正式批次先改這個檔再跑。",
  "owner": "unit.it",
  "reviewedAt": "2026-10-05",
  "siteBase": "https://www.cdc.gov.tw",
  "extraction": {
    "_comment": "舊站版型外殼（導覽列、麵包屑、側欄、頁尾）一律不轉；只取內容區。選擇器語法：#id、.class、tag、tag.class，可用逗號列多個，取第一個命中者。",
    "contentSelectors": [
      "#CCMS_Content",
      "div.cp",
      "main",
      "body"
    ],
    "bodySelectors": [
      ".content-body",
      ".cp-body"
    ],
    "titleSelectors": [
      "h2.title",
      "h1.title",
      "h1"
    ],
    "updatedSelectors": [
      ".update",
      ".last-update"
    ],
    "removeSelectors": [
      "script",
      "style",
      "nav",
      "header",
      "footer",
      ".breadcrumb",
      ".share-bar",
      ".counter",
      ".print-hide",
      ".file-list",
      ".update",
      ".last-update",
      ".back-top",
      "h2.title",
      "h1.title"
    ],
    "faq": {
      "itemSelector": ".panel",
      "questionSelector": ".panel-title",
      "answerSelector": ".panel-body"
    },
    "attachmentLinkPattern": "(/File/(Get|NewGet)/|/Uploads/|\\.(pdf|docx?|odt|xlsx?|csv|ods|pptx?)(\\?|#|$))"
  },
  "urlPatterns": [
    {
      "id": "disease-subindex",
      "match": "^/Disease/SubIndex/",
      "kind": "disease-block",
      "type": "disease",
      "dir": "diseases",
      "label": "疾病頁子頁（併入疾病頁區塊）"
    },
    {
      "id": "qa",
      "match": "^/Category/QAPage/",
      "kind": "faq",
      "type": "faq",
      "dir": "faq",
      "label": "Q&A（每題一筆）"
    },
    {
      "id": "qa-en",
      "match": "^/En/Category/QAPage/",
      "kind": "faq",
      "type": "faq",
      "dir": "faq",
      "lang": "en",
      "label": "英文 Q&A（第八批：sourceLang en，需補中文版）"
    },
    {
      "id": "bulletin-detail",
      "match": "^/Bulletin/Detail/",
      "kind": "news",
      "type": "news",
      "dir": "news",
      "label": "新聞／公告內頁"
    },
    {
      "id": "bulletin-list",
      "match": "^/Bulletin/List/",
      "kind": "list",
      "type": "page",
      "dir": "pages",
      "typeClear": false,
      "label": "新聞列表（新站自動產生，不轉）"
    },
    {
      "id": "file",
      "match": "^/(File/(Get|NewGet)|Uploads)/",
      "kind": "document",
      "type": "document",
      "dir": "documents",
      "asset": true,
      "label": "檔案（宣告為附件；有檔案說明頁者建文件草稿）"
    },
    {
      "id": "infection-report",
      "match": "^/InfectionReport/Info/",
      "kind": "document",
      "type": "document",
      "dir": "documents",
      "docType": "report",
      "label": "出版品／年報"
    },
    {
      "id": "disease-docs",
      "match": "^/Category/Disease(Define|Manual|Teach)/",
      "kind": "document",
      "type": "document",
      "dir": "documents",
      "docTypeByPath": {
        "Define": "case-definition",
        "Manual": "manual",
        "Teach": "guideline"
      },
      "label": "疾病 × 文件矩陣"
    },
    {
      "id": "travel-prescription",
      "match": "^/TravelEpidemic/Prescription/",
      "kind": "generated",
      "type": "page",
      "dir": "pages",
      "newPath": "/travel/{ISO2}/",
      "label": "國際旅遊處方箋國家頁（新站 /travel/{ISO2}/ 由資料產生，不轉內文）"
    },
    {
      "id": "mpage",
      "match": "^/Category/(MPage|Page)/",
      "kind": "page",
      "type": "page",
      "dir": "pages",
      "mergeable": true,
      "label": "欄目內頁（page，或依標題併入疾病頁區塊）"
    },
    {
      "id": "listcontent",
      "match": "^/Category/ListContent/",
      "kind": "page",
      "type": "page",
      "dir": "pages",
      "label": "清單項目內頁"
    },
    {
      "id": "category-list",
      "match": "^/Category/(List|Fpage|NewsPage)",
      "kind": "list",
      "type": "page",
      "dir": "pages",
      "typeClear": false,
      "label": "欄目清單頁（連結集合，通常不轉）"
    }
  ],
  "bulletinTypes": {
    "9": {
      "newsType": "press",
      "label": "新聞稿"
    },
    "11": {
      "newsType": "other",
      "label": "其他訊息"
    },
    "48": {
      "newsType": "letter",
      "type": "letter",
      "label": "致醫界通函",
      "hint": "致醫界通函建成 letter（letterNo 由標題「第 N 號」抽）；對象為醫療院所，audience professional"
    },
    "158": {
      "newsType": "press",
      "label": "英文新聞稿",
      "lang": "en",
      "hint": "英文新聞稿以 sourceLang: en 建立，需補中文版"
    },
    "8772": {
      "newsType": "clarification",
      "type": "clarification",
      "label": "澄清稿",
      "hint": "澄清稿直接建成 clarification（claim／verdict 由標題與內文推斷）"
    }
  },
  "categoryOwners": [
    {
      "match": "結核病／檢驗",
      "owner": "unit.lab"
    },
    {
      "match": "結核病／統計資料",
      "owner": "unit.epidemic-intelligence"
