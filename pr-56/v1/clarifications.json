    {
      "id": "clar.2026-01-vinegar-saltwater-flu",
      "type": "clarification",
      "title": "網傳「燻白醋、喝鹽水可以殺死流感病毒」沒有科學根據",
      "owner": "unit.pr",
      "publishedAt": "2026-01-15",
      "reviewedAt": "2026-07-01",
      "reviewPeriodMonths": 6,
      "status": "published",
      "audience": [
        "public"
      ],
      "tasks": [
