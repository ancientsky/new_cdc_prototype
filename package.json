{
  "name": "cdc-ai-ready-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "疾管署 AI-ready 新官網可動原型：內容與資料只存一份，展示與 AI 都是它的消費者。",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch": "node scripts/fetch-data.mjs",
    "intl:import": "node scripts/intl-epidemic.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test --import ./tests/pin-env.mjs tests/*.test.mjs",
    "eval": "node eval/run-eval.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "gateway:pull": "node scripts/gateway-pull.mjs",
    "a11y": "node scripts/a11y.mjs",
    "perf:ask": "node scripts/perf-ask.mjs",
    "pii": "node scripts/pii-scan.mjs",
    "ask-log:report": "node scripts/ask-log-report.mjs",
    "gen:map": "node scripts/gen-world-map.mjs",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "eval:challenge": "node eval/run-challenge.mjs",
    "eval:holdout2": "node eval/run-challenge.mjs --file=content/governance/eval-holdout2.json"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "marked": "^18.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "i18n-iso-countries": "^7.14.0",
    "pagefind": "^1.5.2",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "world-atlas": "^2.0.2"
  }
}
