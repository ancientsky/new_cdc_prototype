{
  "$id": "https://cdc-prototype/schemas/_common.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "所有內容共同欄位（治理欄位）",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "owner",
    "publishedAt",
    "reviewedAt",
    "reviewPeriodMonths",
    "status",
    "audience",
    "sensitivity",
    "license",
    "languages",
    "summary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9.-]*$",
      "description": "穩定可讀 ID，如 disease.dengue、news.2026-09-22-enterovirus"
    },
    "type": {
      "enum": [
        "disease",
        "faq",
        "news",
        "letter",
        "clarification",
        "document",
        "vaccine",
        "dataset",
        "banner",
        "page",
        "media",
        "topic",
        "service",
        "publication",
        "labtest",
        "research",
        "migration",
        "job",
        "tender"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "pattern": "^unit\\."
    },
    "steward": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "publishedAt": {
      "type": "string",
      "format": "date"
    },
    "publishAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "string",
          "format": "date"
        }
      ],
      "description": "第九輪（ARCHITECTURE 17.1）排程發布：未到此時間（以建置當下真實時間判斷，不受 BUILD_TODAY 影響）⇒ 不渲染、不進索引／sitemap／API／RSS／llms.txt，後台列「排程中」。date-time 須帶時區（例 2026-10-05T09:00:00+08:00）；只填日期＝當日 00:00 台灣時間。主站每 2 小時重建一次，所以實際上線時間最多晚 2 小時。"
    },
    "urgent": {
      "type": "boolean",
      "description": "第九輪（17.1）緊急發布：只有 news／letter／clarification 可用；true ⇒ 走緊急發布車道（檢查通過即上線，公關室 24 小時內上線後複核）"
    },
    "postPublishReview": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "description": "第九輪（17.1）上線後複核（快車道／緊急發布）：status 不是 done ⇒ 治理待辦 post-publish-review（owner 公關室，期限上線後 24 小時；逾期升為高優先）",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "done"
          ]
        },
        "reviewedBy": {
          "type": "string"
        },
        "reviewedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "reviewedAt": {
      "type": "string",
      "format": "date"
    },
    "reviewPeriodMonths": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60
    },
    "nextReviewAt": {
      "type": "string",
      "format": "date",
      "description": "由治理引擎計算，不手填"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "published",
        "archived"
      ]
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "public",
          "professional"
        ]
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "enum": [
          "symptoms",
          "vaccines",
          "travel",
          "situation",
          "rumor",
          "data"
        ]
      }
    },
    "sensitivity": {
      "enum": [
        "public",
        "professional",
        "internal"
      ]
    },
    "license": {
      "type": "string"
    },
    "licenseNote": {
      "type": "string"
    },
    "basedOn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diseases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^disease\\."
      }
    },
    "vaccines": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^vaccine\\."
      }
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "aiWhitelist": {
      "type": "object",
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "approvedBy": {
          "type": "string"
        },
        "approvedAt": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "languages": {
      "type": "object",
      "required": [
        "zh-TW"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "source",
              "reviewed",
              "machine",
              "pending",
              "none"
            ]
          },
          "reviewedAt": {
            "type": "string",
            "format": "date"
          },
          "reviewer": {
            "type": "string"
          },
          "sourceHash": {
            "type": "string"
          }
        }
      },
      "description": "每語言一筆翻譯狀態；來源語言（sourceLang，預設 zh-TW）為 source。zh-TW 一律必填。"
    },
    "sourceLang": {
      "enum": [
        "zh-TW",
        "en",
        "ja",
        "tl",
        "vi",
        "id",
        "th"
      ],
      "default": "zh-TW",
      "description": "內容來源語言（ARCHITECTURE 14.2）：頂層欄位＝此語言文字；languages[sourceLang].status 必須為 source；其他語言（含 sourceLang≠zh-TW 時的 zh-TW）放 i18n.{lang}。sourceLang≠zh-TW 時 i18n[\"zh-TW\"] 必填且 languages[\"zh-TW\"].status 為 reviewed 或 machine（中文官網不能沒有中文）。sourceHash 以來源語言頂層欄位計算。"
    },
    "i18n": {
      "type": "object"
    },
    "sourceHash": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "maxLength": 400
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "legacyUrls": {
      "type": "array",
      "description": "現行官網對應網址（301 對照與來源連結）。舊網址 ID 不確定者以 URI Template 佔位（例：https://www.cdc.gov.tw/Disease/SubIndex/{id}），轉址時標 pattern、不進伺服器對照檔（ARCHITECTURE 13.1）",
      "items": {
        "type": "string",
        "format": "uri-template",
        "pattern": "^https?://"
      }
    },
    "auditRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pattern",
          "message"
        ],
        "properties": {
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pattern": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "linkChecks": {
      "type": "object",
      "description": "連結檢查結果（scripts/fetch-data.mjs --check-links 寫回）：{ applyUrl|videoUrl|pdfUrl: { lastCheckedAt, status } }",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "lastCheckedAt": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "ok",
              "broken",
              "unchecked"
            ]
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "description": "第八輪（ARCHITECTURE 16.1）：本筆內容的檔案資產。檔案放 content/assets/{id}/{file}，建置時複製到 dist/files/{id}/{file}，公開網址 /files/{id}/{file}（不含語言前綴）。條件必填（attachment／data 要 label；image 要 alt 與 license；accessibleAlt 要指向同筆已宣告的檔）、大小與副檔名限制（site.config.assets）、sha256／bytes／mime 核對、SVG 掃描、孤兒檔都在 scripts/lib/assets.mjs 檢查。bytes／sha256／mime／width／height 可用 npm run build -- --fix-assets 自動補寫。",
      "items": {
        "type": "object",
        "required": [
          "file",
          "kind"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*\\.[a-z0-9]+$",
            "maxLength": 120,
            "description": "content/assets/{id}/ 下的檔名：小寫英數、連字號、底線與點，須有副檔名；同筆內容內唯一"
          },
          "kind": {
            "enum": [
              "attachment",
              "image",
              "data"
            ],
            "description": "attachment＝附件（列在頁面附件區）；image＝內文圖片（Markdown 引用）；data＝資料檔（CSV、JSON、XLSX）"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "顯示名稱，如「新聞稿全文（PDF）」；attachment／data 必填"
          },
          "alt": {
            "type": "string",
            "maxLength": 150,
            "description": "替代文字（無障礙）；image 必填（Markdown 內 ![alt] 與此擇一非空即可，渲染時以此補進 <img alt>）"
          },
          "mime": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9.+-]+$",
            "description": "須與副檔名一致；建置時核對"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "檔案大小；建置時核對"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "檔案 SHA-256（小寫 16 進位）；建置時核對，不符 ⇒ 建置失敗並印出實際值"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "description": "圖片寬（px）；--fix-assets 由檔頭讀出（PNG／JPEG／WebP／SVG）"
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "description": "圖片高（px）"
          },
          "machineReadable": {
            "type": "boolean",
            "description": "attachment：PDF 是否有可用的文字層／本身即機讀格式"
          },
          "accessibleAlt": {
            "type": [
              "string",
              "null"
            ],
            "description": "PDF 的可及性替代版本檔名（同筆內容已宣告的 .md／.docx／.odt）；PDF 且 machineReadable 非 true 又沒有 ⇒ 待辦 attachment-no-accessible-version"
          },
          "version": {
            "type": "string",
            "description": "文件型附件的版次（如 114.04.16）"
          },
          "effectiveAt": {
            "type": "string",
            "format": "date"
          },
          "source": {
            "type": "string",
            "description": "圖片／素材來源；非本署素材（license 不是 OGDL-1.0）必填，缺 ⇒ 待辦 image-license-missing"
          },
          "license": {
            "type": "string",
            "description": "圖片授權；image 必填（缺 ⇒ 建置失敗）。本署自製素材填 OGDL-1.0"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "urgent:true 只限 news／letter／clarification（ARCHITECTURE 17.1）",
      "if": {
        "required": [
          "urgent"
        ],
        "properties": {
          "urgent": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "type": {
            "enum": [
              "news",
              "letter",
              "clarification"
            ]
          }
        }
      }
    }
  ]
}
