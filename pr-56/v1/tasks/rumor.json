      {
        "id": "faq.rumor-sms-link",
        "type": "faq",
        "title": "收到自稱疾管署的簡訊要我點連結填資料，怎麼辦？",
        "summary": "疾管署不會以簡訊要求點連結填個資或匯款；收到可疑訊息請勿點擊，撥 165 查證或 1922 詢問。",
        "url": "https://ancientsky.github.io/new_cdc_prototype/preview/pr-56/faq/rumor-sms-link/",
        "path": "/faq/rumor-sms-link/",
        "reviewedAt": "2026-09-16",
        "owner": "unit.pr",
        "ownerName": "公關室",
        "lifecycle": "current",
        "whitelist": true
      },
      {
        "id": "clar.2026-09-anti-epidemic-team-scam",
        "type": "clarification",
        "title": "網傳「防疫國家隊」投資群組為詐騙",
        "summary": "疾管署未成立投資群組，「防疫國家隊」投資訊息為詐騙。",
        "url": "https://ancientsky.github.io/new_cdc_prototype/preview/pr-56/factcheck/#clar.2026-09-anti-epidemic-team-scam",
        "path": "/factcheck/#clar.2026-09-anti-epidemic-team-scam",
